# Copy to .env for local development
DATABASE_URL="postgresql://mtg:mtg@localhost:5432/mtg?schema=public"
NUXT_DATABASE_URL="postgresql://mtg:mtg@localhost:5432/mtg?schema=public"
NUXT_PUBLIC_ORIGIN="http://localhost:3000"
# Scryfall requires an accurate User-Agent on api.scryfall.com requests
NUXT_SCRYFALL_USER_AGENT="arpenteurs/0.1 (contact@example.com)"
# Backoffice access token — /admin is disabled while this is empty
NUXT_ADMIN_TOKEN="change-me-admin"
